// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Plataforma base: identidad, RBAC, sesiones y auditoría.
// Sin modelos de Vendor todavía — eso corresponde a una fase posterior aprobada.
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  userRoles                UserRole[]
  sessions                 Session[]
  auditLogs                AuditLog[]
  vendorOrderStatusChanges VendorOrderStatusHistory[]
  notifications            Notification[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  module     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Vendor: seguimiento de órdenes únicamente. Sin líneas de producto, sin
// Amazon/API, sin inventario. Ver KevalaV1.pdf §10-24 y las decisiones
// registradas en conversación para el alcance exacto de V1.
// ---------------------------------------------------------------------------

enum VendorOrderStatus {
  PENDING
  CONFIRMED
  REJECTED
  DELIVERED

  @@map("vendor_order_status")
}

model VendorOrder {
  id                   String            @id @default(cuid())
  orderNumber          String            @unique @map("order_number")
  amazonOrderId        String?           @unique @map("amazon_order_id")
  status               VendorOrderStatus @default(PENDING)
  orderDate            DateTime          @map("order_date")
  confirmationDeadline DateTime?         @map("confirmation_deadline")
  deliveryDeadline     DateTime?         @map("delivery_deadline")
  confirmedAt          DateTime?         @map("confirmed_at")
  rejectedAt           DateTime?         @map("rejected_at")
  deliveredAt          DateTime?         @map("delivered_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  // Fase 8: captura operativa. Nullable a nivel de esquema para no romper
  // órdenes existentes (p.ej. datos DEMO) creadas antes de esta fase; el
  // formulario de creación exige carrier/mode como obligatorios en la app.
  carrierId String? @map("carrier_id")
  modeId    String? @map("mode_id")

  // Shipping checklist (Fase 8.1): booleanos nullable a propósito. null =
  // todavía no capturado, distinto de false = "No" explícito. Ver
  // src/modules/vendor/domain/shipping-checklist.ts para las reglas de
  // consistencia/completitud que gobiernan estos campos.
  tracking         String?   @map("tracking")
  // Fechas operativas reales (distintas de las deadlines, que son fechas
  // máximas calculadas). Nullable: una orden nueva aún no fue shipped/picked
  // up/entregada. Nunca se calculan automáticamente — las captura el usuario.
  deliveryDate     DateTime? @map("delivery_date")
  pickUpDate       DateTime? @map("pick_up_date")
  shipmentDate     DateTime? @map("shipment_date")
  cartonLabels     Boolean?  @map("carton_labels")
  bol              Boolean?
  palletLabels     Boolean?  @map("pallet_labels")
  asn              Boolean?
  carrierLabels    Boolean?  @map("carrier_labels")
  carrierLabelType String?   @map("carrier_label_type")
  packingSlip      Boolean?  @map("packing_slip")
  invoiceNumber    Int?      @map("invoice_number")

  statusHistory VendorOrderStatusHistory[]
  carrier       Carrier?                    @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  mode          Mode?                       @relation(fields: [modeId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([orderDate])
  @@index([carrierId])
  @@index([modeId])
  @@map("vendor_orders")
}

// ---------------------------------------------------------------------------
// Catálogos Vendor (Fase 8). Sin enum de Prisma: son catálogos administrables
// desde el portal, no un conjunto fijo de valores. Nunca se borran físicamente
// (onDelete: Restrict en VendorOrder) — solo se desactivan (isActive).
// ---------------------------------------------------------------------------

model Carrier {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vendorOrders VendorOrder[]

  @@map("carriers")
}

model Mode {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vendorOrders VendorOrder[]

  @@map("modes")
}

model VendorOrderStatusHistory {
  id             String             @id @default(cuid())
  vendorOrderId  String             @map("vendor_order_id")
  previousStatus VendorOrderStatus? @map("previous_status")
  newStatus      VendorOrderStatus  @map("new_status")
  changedBy      String?            @map("changed_by")
  reason         String?
  comments       String?
  createdAt      DateTime           @default(now()) @map("created_at")

  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  changedByUser User?       @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([vendorOrderId])
  @@map("vendor_order_status_history")
}

// ---------------------------------------------------------------------------
// Notificaciones in-app. Ver KevalaV1.pdf §22 y las decisiones de Fase 7:
// solo canal in-app, sin email/WhatsApp/push, sin reminders/overdue
// (dependen de reglas de deadline aún no aprobadas).
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Products: catálogo maestro de productos de KEVALA (nuevo módulo — por ahora
// solo la sección Catalog). unitOfMeasurement es un enum de Prisma porque es
// un conjunto cerrado y fijo de valores, no administrable desde el portal
// (a diferencia de Carrier/Mode). Nunca se borra físicamente — soft delete
// vía isActive, igual que Carrier/Mode — porque a futuro Marketing/Cosmo -
// Algorithm se relacionará con Product mediante su id interno y un borrado
// físico dejaría esas referencias huérfanas.
// ---------------------------------------------------------------------------

enum UnitOfMeasurement {
  LB
  Gal
  Oz
  Drum
  Tote
  Sticks

  @@map("unit_of_measurement")
}

// Mercados donde puede venderse un producto. Conjunto cerrado y fijo (igual
// razonamiento que UnitOfMeasurement) — un producto puede pertenecer a
// varios a la vez, por eso vive como Country[] en Product, no como un solo
// valor.
enum Country {
  USA
  Mexico
  Canada

  @@map("country")
}

model Product {
  id                String            @id @default(cuid())
  sku               String            @unique
  item              String
  // ASIN (Fase ASIN): identificador de Amazon, independiente del SKU. Se
  // define nullable a nivel de esquema únicamente porque el catálogo ya
  // tenía productos existentes al agregar este campo y no se deben inventar
  // valores para ellos; la aplicación (validation.ts) lo exige siempre en
  // Create/Edit, así que en la práctica ningún producto tocado desde ahora
  // en adelante queda sin ASIN. El índice único sigue protegiendo la
  // unicidad incluso con nulls (Postgres permite múltiples NULL en UNIQUE).
  asin              String?           @unique
  caseOf            Int               @map("case_of")
  casesPerPallet    Int               @map("cases_per_pallet")
  unitOfMeasurement UnitOfMeasurement @map("unit_of_measurement")
  unit              Float
  // Fase 9 (Marketing/Cosmo - Algorithm): un producto puede venderse en
  // varios mercados a la vez, por eso es un array (no un valor único).
  // Nullable/optional a propósito — no todo producto del catálogo tiene
  // presencia en Amazon. Es la única fuente de verdad: Cosmo lo LEE de aquí,
  // nunca lo duplica ni lo modifica desde su propia pantalla.
  country           Country[]         @default([])
  // Igual que country: dato del producto (el link de Amazon), no de cada
  // CosmoPeriod. Opcional porque no todo producto tiene un link de Amazon.
  link              String?
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  cosmoPeriods CosmoPeriod[]

  @@map("products")
}

// ---------------------------------------------------------------------------
// Marketing / Cosmo - Algorithm (Fase 9). Normaliza el Excel de seguimiento
// manual (bloques por producto + columnas dinámicas por periodo) en una
// estructura relacional: Product -> CosmoPeriod -> CosmoChange. A propósito
// NO existe "Week Number": cada periodo se identifica por su rango de
// fechas exacto (startDate/endDate), nunca por un número de semana. Product
// nunca se duplica ni se modifica desde aquí (name/ASIN/Country/Link siguen
// perteneciendo exclusivamente al catálogo).
// ---------------------------------------------------------------------------

model CosmoPeriod {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  unitsSold      Int      @map("units_sold")
  unitsAvailable Int      @map("units_available")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  changes CosmoChange[]

  // Evita importar dos veces exactamente el mismo periodo del mismo producto.
  @@unique([productId, startDate, endDate])
  @@index([productId])
  @@map("cosmo_periods")
}

model CosmoChange {
  id            String   @id @default(cuid())
  cosmoPeriodId String   @map("cosmo_period_id")
  changeDate    DateTime @map("change_date")
  description   String
  // Mercados a los que aplica este Change específico — puede ser un
  // subconjunto de cualquier tamaño de los países configurados en el
  // Product dueño (Catalog), nunca un valor fuera de ese conjunto (se
  // valida en la capa de servicio, no aquí). Se guarda siempre ordenado en
  // el orden fijo del enum (ver sortCountries en validation.ts) para que la
  // restricción UNIQUE de abajo sea independiente del orden de selección.
  country       Country[] @default([])
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cosmoPeriod CosmoPeriod @relation(fields: [cosmoPeriodId], references: [id], onDelete: Cascade)

  // NO es changeDate único por sí solo: un mismo periodo puede tener varios
  // changes el mismo día, siempre que difiera la descripción o el conjunto
  // de mercados. Reimportar exactamente el mismo (periodo, fecha,
  // descripción, mercados) no debe duplicar.
  @@unique([cosmoPeriodId, changeDate, description, country])
  @@index([cosmoPeriodId])
  @@map("cosmo_changes")
}

model Notification {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  type       String
  title      String
  message    String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}
